{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/logs_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "OpenTelemetry": {
    "ServiceName": "brewup-purchase",
    "ServiceVersion": "1.0.0",
    "ServiceInstanceId": "1",
    "ExporterEndpoint": "http://localhost:4317/",
    "TraceRatioSampling": 1.0
  },
  "AllowedHosts": "*"
}
