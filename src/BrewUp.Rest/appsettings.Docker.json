{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/brewup-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "TraceRatioSampling": 1.0
  },
  "Purchase": {
    "MongoDB": {
      "ConnectionString": "mongodb://mongodb:27017",
      "DatabaseName": "brewup-purchase-readmodel"
    },
    "EventStore": {
      "ConnectionString": "esdb://eventstore:2113?tls=false"
    },
    "RabbitMQ": {
      "Host": "rabbitmq",
      "ExchangeCommandName": "brewup.command.exchange",
      "ExchangeEventName": "brewup.event.exchange",
      "Username": "guest",
      "Password": "guest"
    }
  }
}
